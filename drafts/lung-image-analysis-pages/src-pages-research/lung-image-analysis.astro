---
import Layout from '../../components/layout.astro';
import ProjectCard from '../../components/project-card.astro';
---

<Layout
  title="Lung Image Analysis"
  description="Public method summaries for lung image-analysis workflows, including angiogenesis surface area and alveolar morphometry."
  currentPath="/research"
>
  <div class="page-content method-page">
    <nav class="breadcrumb">
      <a href="/research">&larr; All Research</a>
    </nav>

    <section class="method-hero">
      <p class="eyebrow">Lung image analysis</p>
      <h1>Quantitative morphometry from microscopy images</h1>
      <p>
        Public method summaries for reproducible lung image-processing workflows.
        These pages describe the analysis approach and omit unpublished outputs.
      </p>
    </section>

    <section class="methods-grid">
      <ProjectCard
        title="Angiogenesis Surface Area"
        description="A segmentation workflow for phase-contrast tube-formation assays: dark-signal correction, network masking, usable ROI estimation, skeletonization, and projected area measurement."
        collaborators="Stanford University, MD David Cornfield"
        href="/research/lung-angiogenesis-surface-area"
        image="/images/lung-image-analysis/angiogenesis-method.svg"
        imageAlt="Schematic angiogenesis image-analysis workflow"
      />
      <ProjectCard
        title="Alveolar Morphometry"
        description="A Python remake of a Fiji workflow for brightfield lung histology: chord length, septal thickness, local-thickness maps, and alveolar region measurements."
        collaborators="Stanford University, MD David Cornfield"
        href="/research/alveolar-morphometry"
        image="/images/lung-image-analysis/alveolar-method.svg"
        imageAlt="Schematic alveolar morphometry workflow"
      />
    </section>

    <section class="note">
      These pages are method-only. They do not include unpublished result plots,
      raw image fields, review overlays, or condition-level conclusions.
    </section>
  </div>
</Layout>

<style>
  .breadcrumb { margin-bottom: 1.5rem; }
  .breadcrumb a { font-size: 0.9rem; }
  .method-page { max-width: 1050px; }
  .method-hero {
    min-height: 360px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--neutral-light-000);
    background:
      linear-gradient(rgba(8, 27, 34, 0.72), rgba(8, 27, 34, 0.82)),
      url('/images/lung-image-analysis/lung-image-analysis-overview.svg') center / cover,
      var(--neutral-dark-900);
    border-radius: var(--card-radius);
    padding: 3rem;
    overflow: hidden;
    position: relative;
    box-shadow: 0 18px 45px rgba(14, 30, 37, 0.16);
  }
  .method-hero::before,
  .method-hero::after {
    content: "";
    position: absolute;
    border: 8px solid rgba(255, 255, 255, 0.55);
    border-radius: 45% 55% 52% 48%;
  }
  .method-hero::before { width: 220px; height: 145px; right: 15%; top: 18%; transform: rotate(-10deg); }
  .method-hero::after { width: 155px; height: 100px; right: 32%; bottom: 18%; transform: rotate(16deg); }
  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--teal-100);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .method-hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4.6rem);
    line-height: 0.96;
    position: relative;
    z-index: 1;
  }
  .method-hero p:not(.eyebrow) {
    max-width: 720px;
    margin: 1.25rem 0 0;
    color: var(--neutral-light-200);
    font-size: 1.1rem;
    position: relative;
    z-index: 1;
  }
  .methods-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }
  .note {
    border-left: 5px solid var(--gold-500);
    background: var(--gold-000);
    border-radius: var(--card-radius);
    padding: 1rem 1.2rem;
    color: var(--gold-900);
  }
  @media (max-width: 700px) {
    .method-hero { padding: 2rem; }
    .methods-grid { grid-template-columns: 1fr; }
  }
</style>
